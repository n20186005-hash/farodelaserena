---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const t = messages.timeline;
---

<section id="timeline" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{t.title}</h2>
    <p class="text-base sm:text-lg mb-10" style="color: var(--text-secondary);">{t.subtitle}</p>

    <ol class="relative" style="border-left: 2px solid var(--border-color);">
      {t.items.map((item) => (
        <li class="relative pl-6 sm:pl-8 pb-8 last:pb-0">
          <span class="absolute -left-[7px] top-1.5 w-3 h-3 rounded-full" style="background: var(--accent); box-shadow: 0 0 0 4px var(--bg-secondary);"></span>
          <p class="font-display text-sm sm:text-base font-semibold tracking-wide mb-1" style="color: var(--accent);">{item.year}</p>
          <h3 class="font-semibold text-lg mb-2" style="color: var(--text-primary);">{item.title}</h3>
          <p class="text-sm sm:text-base leading-relaxed" style="color: var(--text-secondary);">{item.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
