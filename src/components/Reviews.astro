---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const r = messages.reviews;
const ratingNum = Math.round(parseFloat(r.ratingValue || '0'));
---

<section id="reviews" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{r.title}</h2>
    <p class="text-center text-base mb-10" style="color: var(--text-secondary);">{r.declaration}</p>

    <div class="rounded-2xl p-6 border max-w-xl mx-auto" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
      <div class="flex items-center gap-4">
        <span class="text-4xl font-display font-bold" style="color: var(--accent);">{r.ratingValue}</span>
        <div>
          <div class="text-lg tracking-wide" style="color: var(--accent);">{'★'.repeat(ratingNum)}<span style="color: var(--text-muted);">{'★'.repeat(5 - ratingNum)}</span></div>
          <p class="text-sm" style="color: var(--text-secondary);">{r.ratingCount} opiniones · Google Maps</p>
        </div>
      </div>
      {r.ratingNote && (
        <p class="mt-4 text-sm leading-relaxed" style="color: var(--text-secondary);">{r.ratingNote}</p>
      )}
    </div>

    <div class="text-center mt-10">
      <a href={r.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-full sm:w-auto justify-center px-8 py-3 rounded-full font-semibold text-white" style="background: var(--accent);">
        📍 {r.moreReviews}
      </a>
    </div>
  </div>
</section>
